Config {
       font = "Noto Sans Mono CJK JP Bold 10"
       , additionalFonts = ["Symbola Regular 10"]
       , bgColor = "#4E4B42"
       , fgColor = "#DAD4BB"
       , position = TopSize L 95 30
       , lowerOnStart = False
       , commands = [
                      Run Com "cat" ["/tmp/xmobar_metrics"] "metrics" 2
                    , Run StdinReader
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "}%StdinReader% {%metrics%"
       }
